<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Bộ màu 1 — Xanh Dương (Modern Tech & Corporate) theo rule.md Mục 4 -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryDarkText">#0F172A</Color>
    <Color x:Key="Secondary">#EFF6FF</Color>
    <Color x:Key="SecondaryDarkText">#1D4ED8</Color>
    <Color x:Key="Tertiary">#0EA5E9</Color>

    <!-- Nền & Bề mặt (Background & Surface) -->
    <Color x:Key="LightBackground">#F8FAFC</Color>
    <Color x:Key="DarkBackground">#0F172A</Color>
    <Color x:Key="LightSecondaryBackground">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryBackground">#1E293B</Color>
    <Color x:Key="DarkCardBackground">#1E293B</Color>
    <Color x:Key="DarkOnLightBackground">#0F172A</Color>
    <Color x:Key="LightOnDarkBackground">#F8FAFC</Color>

    <!-- Văn bản & Đường viền chuẩn (Text & Borders) -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="BorderDivider">#E2E8F0</Color>
    <Color x:Key="BorderDividerDark">#334155</Color>

    <!-- Input & Form Tokens -->
    <Color x:Key="InputBackgroundLight">#F8FAFC</Color>
    <Color x:Key="InputBackgroundDark">#0F172A</Color>
    <Color x:Key="InputBorderLight">#CBD5E1</Color>
    <Color x:Key="InputBorderDark">#475569</Color>
    <Color x:Key="LabelTextLight">#334155</Color>
    <Color x:Key="LabelTextDark">#E2E8F0</Color>

    <!-- Trạng thái (Status & Roles) -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessDark">#059669</Color>
    <Color x:Key="SuccessBgLight">#ECFDF5</Color>
    <Color x:Key="SuccessBgDark">#052E16</Color>
    <Color x:Key="SuccessBorderLight">#A7F3D0</Color>
    <Color x:Key="SuccessBorderDark">#14532D</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningTextLight">#92400E</Color>
    <Color x:Key="WarningTextDark">#FDE68A</Color>
    <Color x:Key="WarningBgLight">#FFFBEB</Color>
    <Color x:Key="WarningBgDark">#451A03</Color>

    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorDark">#DC2626</Color>
    <Color x:Key="ErrorTextLight">#991B1B</Color>
    <Color x:Key="ErrorTextDark">#FECACA</Color>
    <Color x:Key="ErrorBgLight">#FEF2F2</Color>
    <Color x:Key="ErrorBgDark">#450A0A</Color>
    <Color x:Key="ErrorBorderLight">#FECACA</Color>
    <Color x:Key="ErrorBorderDark">#7F1D1D</Color>

    <Color x:Key="InfoBgLight">#EFF6FF</Color>
    <Color x:Key="InfoBgDark">#172554</Color>
    <Color x:Key="InfoBorderLight">#BFDBFE</Color>
    <Color x:Key="InfoBorderDark">#1E3A8A</Color>
    <Color x:Key="InfoTextLight">#1E40AF</Color>
    <Color x:Key="InfoTextDark">#93C5FD</Color>

    <Color x:Key="TranslucentWhite">#33FFFFFF</Color>
    <Color x:Key="TranslucentBlack">#80000000</Color>
    <Color x:Key="HeaderSubtitleColor">#DBEAFE</Color>
    <Color x:Key="OverlayBackdrop">#80000000</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1E3A8A</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#1E293B</Color>

    <!-- Page & Typography Color Aliases -->
    <Color x:Key="BackgroundLight">#F8FAFC</Color>
    <Color x:Key="DarkPageBackground">#0F172A</Color>
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="OverlayScrimColor">#80000000</Color>
    <Color x:Key="Gray950">#0F172A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="DarkCardBackgroundBrush" Color="{StaticResource DarkCardBackground}"/>
    <SolidColorBrush x:Key="TranslucentBlackBrush" Color="{StaticResource TranslucentBlack}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary}" Offset="0.0"/>
        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StudentCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MidnightBlue}" Offset="0.0"/>
        <GradientStop Color="{StaticResource PrimaryDark}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Primary}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmeraldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SuccessColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SuccessDark}" Offset="1.0"/>
    </LinearGradientBrush>
</ResourceDictionary>