<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Premium Palette -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#6366F1</Color>
    <Color x:Key="PrimaryDark">#3730A3</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    
    <Color x:Key="Secondary">#EEF2FF</Color>
    <Color x:Key="SecondaryDarkText">#4F46E5</Color>
    <Color x:Key="Tertiary">#7C3AED</Color>

    <!-- Semantic State Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessBg">#ECFDF5</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningBg">#FFFBEB</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerBg">#FEF2F2</Color>
    <Color x:Key="Info">#0284C7</Color>
    <Color x:Key="InfoBg">#F0F9FF</Color>

    <!-- Backgrounds & Surfaces -->
    <Color x:Key="LightBackground">#F8FAFC</Color>
    <Color x:Key="DarkBackground">#0F172A</Color>
    <Color x:Key="LightSecondaryBackground">#F1F5F9</Color>
    <Color x:Key="DarkSecondaryBackground">#1E293B</Color>
    <Color x:Key="DarkOnLightBackground">#0F172A</Color>
    <Color x:Key="LightOnDarkBackground">#F8FAFC</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1E1B4B</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <!-- Grays / Slates -->
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Premium Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0.0" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0.0" />
        <GradientStop Color="#4F46E5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StudentCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E1B4B" Offset="0.0" />
        <GradientStop Color="#312E81" Offset="0.5" />
        <GradientStop Color="#4338CA" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0.0" />
        <GradientStop Color="#10B981" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0.0" />
        <GradientStop Color="#F59E0B" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0.0" />
        <GradientStop Color="#EF4444" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>