<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusActivitiesManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:CampusActivitiesManager.Pages"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
    Title="Campus Activities Manager">

    <Shell.FlyoutHeader>
        <Border BackgroundColor="{StaticResource Primary}" Padding="20,24" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.0" />
                    <GradientStop Color="#7C3AED" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="0">
                    <Label Text="🎓" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="Campus Hub" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Quản lý Hoạt động Sinh viên" FontSize="12" TextColor="#E0E7FF"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <!-- 3. Màn hình Đăng nhập (Login) - MUST BE FIRST -->
    <ShellContent
        x:Name="NavLogin"
        Title="Tài khoản &amp; Đăng nhập"
        Icon="{StaticResource IconAccount}"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <!-- 1. Cổng Sinh Viên -->
    <ShellContent
        x:Name="NavStudentDashboard"
        Title="Cổng Sinh Viên"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="main" />

    <!-- 2. Quản lý Tài khoản -->
    <ShellContent
        x:Name="NavUsers"
        Title="Quản lý Tài khoản"
        Icon="{StaticResource IconUsers}"
        ContentTemplate="{DataTemplate pages:UserManagementPage}"
        Route="users" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
