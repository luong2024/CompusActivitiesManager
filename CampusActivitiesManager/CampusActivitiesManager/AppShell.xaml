<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusActivitiesManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:CampusActivitiesManager.Pages"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
    Title="Campus Activities Manager">

    <Shell.FlyoutHeader>
        <Border Background="{StaticResource PrimaryGradientBrush}" Padding="20,24" StrokeThickness="0">
            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Border x:Name="FlyoutAvatarBorder" WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 23" BackgroundColor="{StaticResource TranslucentWhite}" StrokeThickness="0" Padding="0">
                    <Label x:Name="FlyoutAvatarText" Text="🎓" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource White}"/>
                </Border>
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label x:Name="FlyoutUserName" Text="Campus Hub" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                    <Label x:Name="FlyoutUserRole" Text="Quản lý Hoạt động Sinh viên" FontSize="12" TextColor="{StaticResource HeaderSubtitleColor}"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <!-- Màn hình Đăng nhập (Login) - Ẩn khỏi Flyout & Không hiện TabBar -->
    <ShellContent
        Route="login"
        FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- 🌟 Commercial Bottom TabBar (Trang chủ, Sự kiện, Quét QR, Lớp học, Cá nhân) -->
    <TabBar x:Name="AppTabBar">
        <!-- 1. Trang chủ -->
        <Tab Title="Trang chủ" Icon="{StaticResource IconDashboard}" Route="homeTab">
            <ShellContent Route="main" ContentTemplate="{DataTemplate pages:MainPage}" />
        </Tab>

        <!-- 2. Sự kiện -->
        <Tab Title="Sự kiện" Icon="{StaticResource IconCalendar}" Route="eventsTab">
            <ShellContent Route="events" ContentTemplate="{DataTemplate pages:EventManagementPage}" />
        </Tab>

        <!-- 3. Quét QR -->
        <Tab Title="Quét QR" Icon="{StaticResource IconDashboard}" Route="qrTab">
            <ShellContent Route="qrscan" ContentTemplate="{DataTemplate pages:QrScannerPage}" />
        </Tab>

        <!-- 4. Lớp học -->
        <Tab Title="Lớp học" Icon="{StaticResource IconUsers}" Route="classTab">
            <ShellContent Route="classhub" ContentTemplate="{DataTemplate pages:ClassHubPage}" />
        </Tab>

        <!-- 5. Cá nhân -->
        <Tab Title="Cá nhân" Icon="{StaticResource IconAccount}" Route="profileTab">
            <ShellContent Route="profile" ContentTemplate="{DataTemplate pages:ProfilePage}" />
        </Tab>
    </TabBar>

    <!-- Danh mục điều hướng trong thanh Menu (Flyout Menu Items) -->
    <MenuItem Text="🏠 Trang chủ" Clicked="OnNavigateHomeClicked" />
    <MenuItem Text="📅 Sự kiện &amp; Hoạt động" Clicked="OnNavigateEventsClicked" />
    <MenuItem Text="📷 Quét mã QR sự kiện" Clicked="OnNavigateQrClicked" />
    <MenuItem Text="🎓 Quản lý Lớp học" Clicked="OnNavigateClassClicked" />
    <MenuItem Text="👤 Hồ sơ cá nhân" Clicked="OnNavigateProfileClicked" />

    <!-- Admin & Management Special Flyout Items -->
    <FlyoutItem x:Name="FlyoutUsers" Title="👥 Quản lý Người dùng (Admin)" Icon="{StaticResource IconUsers}">
        <ShellContent Route="users" ContentTemplate="{DataTemplate pages:UserManagementPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="FlyoutReports" Title="📊 Báo cáo &amp; Điểm danh" Icon="{StaticResource IconProjects}">
        <ShellContent Route="attendancereport" ContentTemplate="{DataTemplate pages:EventAttendanceReportPage}" />
    </FlyoutItem>

    <!-- Đăng xuất (Logout) MenuItem -->
    <MenuItem Text="🚪 Đăng xuất khỏi hệ thống" Clicked="OnLogoutMenuItemClicked" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
