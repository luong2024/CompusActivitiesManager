<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusActivitiesManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:CampusActivitiesManager.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="Campus Activities Manager">

    <!-- 1. Màn hình Đăng nhập (Login) - BẮT BUỘC KHỞI ĐỘNG TRƯỚC -->
    <ShellContent
        x:Name="NavLogin"
        Title="Tài khoản &amp; Đăng nhập"
        Icon="{StaticResource IconAccount}"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <!-- 2. Màn hình Cổng Sinh Viên (Student Dashboard) -->
    <ShellContent
        x:Name="NavStudentDashboard"
        Title="Cổng Sinh Viên"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="main" />

    <!-- Sự kiện -->
    <ShellContent
        x:Name="NavEvents"
        Title="Sự kiện"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:EventListPage}"
        Route="events" />

    <!-- 3. Màn hình Quản lý Tài khoản (Admin / AC 1.1) -->
    <ShellContent
        x:Name="NavUsers"
        Title="Quản lý Tài khoản"
        Icon="{StaticResource IconUsers}"
        ContentTemplate="{DataTemplate pages:UserManagementPage}"
        Route="users" />

    <!-- 4. Màn hình Cập nhật thông tin cá nhân (Profile) -->
    <ShellContent
        x:Name="NavProfile"
        Title="Thông tin cá nhân"
        Icon="{StaticResource IconAccount}"
        ContentTemplate="{DataTemplate pages:ProfilePage}"
        Route="profile" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>

