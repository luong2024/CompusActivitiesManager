<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             x:DataType="pageModels:CreateUserViewModel"
             x:Class="CampusActivitiesManager.Pages.CreateUserPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" MaximumWidthRequest="600" HorizontalOptions="Center">

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Thông tin tài kho?n m?i" FontAttributes="Bold" FontSize="18" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email (*)" FontAttributes="Bold" FontSize="14" />
                        <Entry Text="{Binding Email}" Placeholder="Ví d?: sinhvien@gmail.com" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="H? và tên (*)" FontAttributes="Bold" FontSize="14" />
                        <Entry Text="{Binding FullName}" Placeholder="Nh?p h? tên d?y d?" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mã sinh viên / Username" FontAttributes="Bold" FontSize="14" />
                        <Entry Text="{Binding Username}" Placeholder="Ð? tr?ng s? t? t?o t? Email" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="S? di?n tho?i" FontAttributes="Bold" FontSize="14" />
                        <Entry Text="{Binding PhoneNumber}" Placeholder="Nh?p s? di?n tho?i" Keyboard="Telephone" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Vai trò (Role):" FontAttributes="Bold" FontSize="14" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                                Padding="8,2"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#111827}">
                            <Picker ItemsSource="{Binding AvailableRoles}"
                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                    Title="-- Ch?n vai trò --"
                                    HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="H?y b?"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#374151, Dark=#F9FAFB}"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="Luu tài kho?n"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
