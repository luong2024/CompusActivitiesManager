<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="pageModels:LoginPageModel"
             x:Class="CampusActivitiesManager.Pages.LoginPage"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="Đăng nhập">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30" MaximumWidthRequest="460" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Logo & Title Header -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 20" StrokeThickness="0" Background="{StaticResource PrimaryGradientBrush}" HorizontalOptions="Center" Padding="0">
                    <Label Text="🎓" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Campus Activities Manager" Style="{StaticResource Title2}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Hệ thống Quản lý Hoạt động &amp; Phân quyền RBAC" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Form Đăng nhập -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="24">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Đăng nhập Hệ thống" Style="{StaticResource Title3}" />
                        <Label Text="Vui lòng nhập thông tin tài khoản của bạn để tiếp tục" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>



                    <!-- Error Alert -->
                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource ErrorBorderLight}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBgLight}, Dark={StaticResource ErrorBgDark}}"
                            Padding="12,10"
                            IsVisible="{Binding HasError}">
                        <Label AutomationId="lblError" Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorDark}" FontSize="13" />
                    </Border>

                    <!-- Username / Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tên đăng nhập / Email" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry AutomationId="txtUsername"
                                   Text="{Binding UsernameOrEmail}"
                                   Placeholder="Nhập email hoặc mã số sinh viên"
                                   Keyboard="Email"
                                   FontSize="14"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2,4,2">
                            <Grid ColumnDefinitions="*,40">
                                <Entry AutomationId="txtPassword"
                                       Grid.Column="0"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       Placeholder="Nhập mật khẩu"
                                       FontSize="14"
                                       HeightRequest="42" />
                                <ImageButton AutomationId="btnTogglePassword"
                                             Grid.Column="1"
                                             Command="{Binding TogglePasswordVisibilityCommand}"
                                             BackgroundColor="Transparent"
                                             HeightRequest="38" WidthRequest="38"
                                             Padding="8"
                                             Opacity="0.65">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="True">
                                            <Setter Property="Source" Value="eye_off.png" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="False">
                                            <Setter Property="Source" Value="eye_on.png" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Remember Me -->
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox AutomationId="chkRememberMe" IsChecked="{Binding RememberMe}" Color="{StaticResource Primary}" />
                        <Label Text="Ghi nhớ đăng nhập" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    </HorizontalStackLayout>

                    <!-- Login Button -->
                    <Button AutomationId="btnLogin"
                            Command="{Binding LoginCommand}"
                            Background="{StaticResource PrimaryGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="48"
                            CornerRadius="12"
                            IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                            Margin="0,4,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Text" Value="Đang đăng nhập..." />
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Text" Value="Đăng nhập" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Đăng ký tài khoản mới & Quên mật khẩu -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="Chưa có tài khoản sinh viên?"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   VerticalOptions="Center" />
                            <Button AutomationId="btnRegister"
                                    Text="Đăng ký ngay"
                                    Command="{Binding NavigateToRegisterCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="6,2" />
                        </HorizontalStackLayout>

                        <Button AutomationId="btnForgotPassword"
                                Text="Quên mật khẩu?"
                                Command="{Binding ForgotPasswordCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Gray500}"
                                FontSize="12.5"
                                Padding="8,2"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
