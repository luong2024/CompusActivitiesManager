<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             x:Class="CampusActivitiesManager.Pages.Controls.AccountCardView"
             x:DataType="models:Account">

    <!-- Modern Elevated Account Card -->
    <Border StrokeShape="RoundRectangle 20"
            Padding="16"
            Margin="0,4"
            Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    Offset="0,4"
                    Radius="14"
                    Opacity="{AppThemeBinding Light=0.08, Dark=0.3}" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="12">

            <!-- Top Row: Avatar, Name, Student Code, Points Badge, Action Menu -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">

                <!-- Avatar Circle with Fallback Initials -->
                <Grid Grid.Column="0" WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                    <Border WidthRequest="50" HeightRequest="50"
                            StrokeShape="RoundRectangle 25"
                            Background="{Binding RoleBgBrush}"
                            StrokeThickness="1.5"
                            Stroke="{Binding RoleColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IsVisible="{Binding HasAvatar, Converter={toolkit:InvertedBoolConverter}}">
                        <Label Text="{Binding Initials}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{Binding RoleColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Border WidthRequest="50" HeightRequest="50"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="2"
                            Stroke="{StaticResource Primary}"
                            IsVisible="{Binding HasAvatar}">
                        <Image Source="{Binding AvatarUrl}"
                               Aspect="AspectFill"
                               WidthRequest="50"
                               HeightRequest="50" />
                    </Border>
                </Grid>

                <!-- Full Name, Student Code & Class -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding FullName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="6,2"
                                Background="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkBackground}}"
                                StrokeThickness="0">
                            <Label Text="{Binding StudentCode}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                        
                        <Label Text="•"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               VerticalOptions="Center" />
                               
                        <Label Text="{Binding ClassName}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Training Points Badge (Điểm rèn luyện) -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,4"
                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkBackground}}"
                        StrokeThickness="1"
                        Stroke="{Binding PointRankColor}"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="⭐" FontSize="10" VerticalOptions="Center" />
                            <Label Text="{Binding TrainingPoints}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{Binding PointRankColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding PointRank}"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="{Binding PointRankColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action Menu Button (3 dots) -->
                <Button Grid.Column="3"
                        ImageSource="{StaticResource IconMore}"
                        Background="Transparent"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Command="{Binding AccountActionCommand, Source={RelativeSource AncestorType={x:Type pageModels:AccountListPageModel}}, x:DataType=pageModels:AccountListPageModel}"
                        CommandParameter="{Binding .}"
                        SemanticProperties.Description="Tác vụ tài khoản" />
            </Grid>

            <!-- Middle Row: Contact Info (Email & Phone) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Image Source="{StaticResource IconMail}"
                           WidthRequest="14" HeightRequest="14"
                           Opacity="0.7"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Email}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Label Text="📞" FontSize="11" VerticalOptions="Center" />
                    <Label Text="{Binding PhoneNumber}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Divider Line -->
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

            <!-- Bottom Row: Status Tag, Role Badge, Cohort Chip -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <!-- Status Tag (Đang học / Bảo lưu / Bị khóa) -->
                    <Border StrokeShape="RoundRectangle 12"
                            Padding="8,4"
                            Background="{Binding StatusBgBrush}"
                            StrokeThickness="0">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <BoxView WidthRequest="6" HeightRequest="6"
                                     CornerRadius="3"
                                     Color="{Binding StatusColor}"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding StatusName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding StatusColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Role Tag (Admin / Sinh viên / Giảng viên...) -->
                    <Border StrokeShape="RoundRectangle 12"
                            Padding="8,4"
                            Background="{Binding RoleBgBrush}"
                            StrokeThickness="0">
                        <Label Text="{Binding RoleName}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{Binding RoleColor}"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Academic Cohort Chip (K20, K21...) -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="8,3"
                        Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Label Text="{Binding AcademicYear}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>
