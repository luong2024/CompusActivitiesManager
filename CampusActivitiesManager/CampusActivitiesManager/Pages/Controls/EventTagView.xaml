<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusActivitiesManager.Pages.Controls"
             x:Class="CampusActivitiesManager.Pages.Controls.EventTagView"
             x:DataType="controls:EventTagView"
             x:Name="TagControl">

    <!-- AC 1.3: Pill-shaped badge (Bo góc dạng viên thuốc) -->
    <Border StrokeShape="RoundRectangle 16"
            Padding="10,4"
            HeightRequest="28"
            StrokeThickness="0"
            Background="{Binding DisplayColor, Source={x:Reference TagControl}}"
            SemanticProperties.Description="{Binding TooltipText, Source={x:Reference TagControl}}"
            ToolTipProperties.Text="{Binding TooltipText, Source={x:Reference TagControl}}">
        
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTagTapped" />
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
            <!-- Optional Status Indicator Dot -->
            <BoxView WidthRequest="6" HeightRequest="6"
                     CornerRadius="3"
                     Color="{Binding TextColor, Source={x:Reference TagControl}}"
                     VerticalOptions="Center" />

            <!-- AC 1.3: Truncate / Shorten if title > 15 chars -->
            <Label Text="{Binding FormattedTitle, Source={x:Reference TagControl}}"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{Binding TextColor, Source={x:Reference TagControl}}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
