<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             x:DataType="pageModels:EditUserRoleViewModel"
             x:Class="CampusActivitiesManager.Pages.EditUserRolePage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="{StaticResource LayoutPadding}" MaximumWidthRequest="600" HorizontalOptions="Center">

            <!-- Card Thông tin Tài khoản -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Thông tin Người dùng" Style="{StaticResource Title3}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                HeightRequest="56"
                                WidthRequest="56"
                                StrokeShape="RoundRectangle 28"
                                Stroke="Transparent"
                                BackgroundColor="{Binding User.RoleBadgeColor}"
                                VerticalOptions="Center">
                            <Label Text="{Binding User.AvatarInitials}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding User.FullName}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding User.Username, StringFormat='@{0}'}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="{Binding User.Email}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="{Binding User.Department}" FontSize="13" FontAttributes="Italic" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Form Biên tập Phân quyền (Picker TwoWay Binding) -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Cấu hình Vai trò &amp; Quyền hạn" Style="{StaticResource Title3}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Chọn vai trò người dùng (Role):" FontAttributes="Bold" FontSize="14" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                                Padding="8,2"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#111827}">
                            <Picker ItemsSource="{Binding AvailableRoles}"
                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                    Title="-- Chọn vai trò --"
                                    HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mô tả vai trò được chọn -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Mô tả thẩm quyền:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}" FontSize="13" />
                            <Label Text="{Binding RoleDescription}" TextColor="{AppThemeBinding Light=#3730A3, Dark=#C7D2FE}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#374151, Dark=#F9FAFB}"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="💾 Lưu phân quyền"
                                Command="{Binding SaveRoleCommand}"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
