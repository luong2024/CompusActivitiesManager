<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             x:DataType="pageModels:EditUserRoleViewModel"
             x:Class="CampusActivitiesManager.Pages.EditUserRolePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24,32" MaximumWidthRequest="580" HorizontalOptions="Center">

            <!-- Header Banner -->
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="24,20" Background="{StaticResource PrimaryGradientBrush}">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 14" BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="0">
                        <Label Text="🛡️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Chỉnh Sửa Tài Khoản &amp; Phân Quyền" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Cập nhật thông tin hồ sơ và vai trò truy cập (RBAC)" FontSize="13" TextColor="#E0E7FF" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Card Thông tin Tài khoản -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    Padding="28">
                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email (Không thể sửa)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}"
                                Padding="12,2">
                            <Entry Text="{Binding User.Email}" IsEnabled="False" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Họ và tên (*)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Padding="12,2">
                            <Entry Text="{Binding User.FullName}" Placeholder="Nhập họ tên đầy đủ" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mã sinh viên / Username (Không thể sửa)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}"
                                Padding="12,2">
                            <Entry Text="{Binding User.Username}" IsEnabled="False" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Số điện thoại" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Padding="12,2">
                            <Entry Text="{Binding User.PhoneNumber}" Placeholder="Nhập số điện thoại" Keyboard="Telephone" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Vai trò (Role)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                                StrokeThickness="1"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">
                            <Picker ItemsSource="{Binding AvailableRoles}"
                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                    Title="-- Chọn vai trò --"
                                    FontSize="14"
                                    HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mô tả vai trò -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#C7D2FE, Dark=#312E81}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ℹ️ Mô tả thẩm quyền" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}" FontSize="13" />
                            <Label Text="{Binding RoleDescription}" TextColor="{AppThemeBinding Light=#3730A3, Dark=#C7D2FE}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#475569, Dark=#E2E8F0}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="💾 Lưu thay đổi"
                                Command="{Binding SaveRoleCommand}"
                                Background="{StaticResource PrimaryGradientBrush}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
