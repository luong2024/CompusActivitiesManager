<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             x:DataType="pageModels:EditUserRoleViewModel"
             x:Class="CampusActivitiesManager.Pages.EditUserRolePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24,32" MaximumWidthRequest="580" HorizontalOptions="Center">

            <!-- Header Banner -->
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="24,20" Background="{StaticResource PrimaryGradientBrush}">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource TranslucentWhite}" StrokeThickness="0" Padding="0">
                        <Label Text="🛡️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Chỉnh Sửa Tài Khoản &amp; Phân Quyền" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource White}" />
                        <Label Text="Cập nhật thông tin hồ sơ và vai trò truy cập (RBAC)" FontSize="13" TextColor="{StaticResource HeaderSubtitleColor}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Card Thông tin Tài khoản -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="28">
                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email (Không thể sửa)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry Text="{Binding User.Email}" IsEnabled="False" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Họ và tên (*)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry Text="{Binding User.FullName}" Placeholder="Nhập họ tên đầy đủ" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mã sinh viên / Username (Không thể sửa)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry Text="{Binding User.Username}" IsEnabled="False" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Số điện thoại" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry Text="{Binding User.PhoneNumber}" Placeholder="Nhập số điện thoại" Keyboard="Telephone" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Vai trò (Role)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}">
                            <Picker ItemsSource="{Binding AvailableRoles}"
                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                    Title="-- Chọn vai trò --"
                                    FontSize="14"
                                    HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Lớp sinh hoạt / Lớp phụ trách -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Lớp học / Đơn vị phụ trách" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}">
                            <Picker ItemsSource="{Binding AvailableClasses}"
                                    ItemDisplayBinding="{Binding ClassName, x:DataType='models:ClassRoom'}"
                                    SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                    Title="-- Chọn lớp học --"
                                    FontSize="14"
                                    HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Đối với Giảng viên: Danh sách nhiều lớp phụ trách -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Các lớp phụ trách (cho Giảng viên - phân cách bằng dấu phẩy)" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry Text="{Binding ManagedClasses}" Placeholder="Ví dụ: D20CNTT1, D21CNTT1, D22QTKD1" FontSize="13" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mô tả vai trò -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource InfoBorderLight}, Dark={StaticResource InfoBorderDark}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InfoBgLight}, Dark={StaticResource InfoBgDark}}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ℹ️ Mô tả thẩm quyền" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource InfoTextDark}}" FontSize="13" />
                            <Label Text="{Binding RoleDescription}" TextColor="{AppThemeBinding Light={StaticResource InfoTextLight}, Dark={StaticResource HeaderSubtitleColor}}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderDividerDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource LabelTextDark}}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="💾 Lưu thay đổi"
                                Command="{Binding SaveRoleCommand}"
                                Background="{StaticResource PrimaryGradientBrush}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
