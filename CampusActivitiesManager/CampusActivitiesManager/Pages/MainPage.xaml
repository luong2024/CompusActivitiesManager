<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"             
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CampusActivitiesManager.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="OverviewPage"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark={StaticResource DarkBackground}}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Trang chủ">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
            EventName="Appearing"                
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- 1. TOP APP BAR / BRAND HEADER -->
        <Border Grid.Row="0"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                StrokeThickness="0"
                Padding="16,12">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.05" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Nút Hamburger Menu (Mở thanh menu) -->
                <Border Grid.Column="0"
                        WidthRequest="42" HeightRequest="42"
                        StrokeShape="RoundRectangle 12"
                        Background="{AppThemeBinding Light=#EFF6FF, Dark={StaticResource DarkCardBackground}}"
                        Stroke="{AppThemeBinding Light=#BFDBFE, Dark={StaticResource Gray700}}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="☰"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Branding & Greeting -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10"
                            Background="{StaticResource PrimaryGradientBrush}" StrokeThickness="0" VerticalOptions="Center">
                        <Label Text="🎓" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding StudentGreeting}" FontSize="14.5" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Text="{Binding RoleSubtitle}" FontSize="11" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" 
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <!-- Notification Bell Button with Badge -->
                    <Grid WidthRequest="40" HeightRequest="40">
                        <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12"
                                Background="{AppThemeBinding Light=#EFF6FF, Dark={StaticResource DarkCardBackground}}"
                                Stroke="{AppThemeBinding Light=#BFDBFE, Dark={StaticResource Gray700}}"
                                StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleNotificationsModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="🔔" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Unread Count Badge -->
                        <Border IsVisible="{Binding HasUnreadNotifications}"
                                WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9"
                                BackgroundColor="#EF4444" StrokeThickness="0"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,-2,-2"
                                InputTransparent="True">
                            <Label Text="{Binding UnreadNotificationsCount}" FontSize="10" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Profile Shortcut Badge -->
                    <Border StrokeShape="RoundRectangle 20" 
                            Background="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCardBackground}}" 
                            StrokeThickness="1" Stroke="{StaticResource Gray200}" Padding="8,4" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" Background="#2563EB" StrokeThickness="0">
                                <Label Text="{Binding CurrentStudent.Initials}" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Hồ sơ" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 2. SCROLLABLE MAIN CONTENT -->
        <pullToRefresh:SfPullToRefresh
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshCommand="{Binding RefreshCommand}">
            <pullToRefresh:SfPullToRefresh.PullableContent>
                <ScrollView>
                    <VerticalStackLayout Spacing="18" Padding="16,16,16,80">

                        <!-- ============================================== -->
                        <!-- A. HERO CARD: SINH VIÊN & BÍ THƯ (DIGITAL PASS) -->
                        <!-- ============================================== -->
                        <Border IsVisible="{Binding IsStudentOrSecretary}"
                                StrokeShape="RoundRectangle 22"
                                Background="{StaticResource StudentCardGradient}"
                                Padding="20"
                                StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource MidnightBlue}" Offset="0,8" Radius="20" Opacity="0.35" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="16">
                                <!-- Student Info Row -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0"
                                            WidthRequest="52" HeightRequest="52"
                                            StrokeShape="RoundRectangle 16"
                                            Background="#30FFFFFF"
                                            StrokeThickness="1.5"
                                            Stroke="#60FFFFFF"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding CurrentStudent.Initials}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource White}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding CurrentStudent.FullName}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource White}"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1" StrokeShape="RoundRectangle 8"
                                                    Background="#2510B981"
                                                    StrokeThickness="1"
                                                    Stroke="#5010B981"
                                                    Padding="6,2">
                                                <Label Text="{Binding CurrentStudent.AcademicYear}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#34D399" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding CurrentStudent.StudentCode, StringFormat='MSV: {0}'}"
                                               FontSize="11.5"
                                               FontAttributes="Bold"
                                               TextColor="#CBD5E1" />
                                        <Label Text="{Binding CurrentStudent.ClassName}"
                                               FontSize="11"
                                               TextColor="#CBD5E1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- QR Ticket Button -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 14"
                                            Background="#FFFFFF"
                                            StrokeThickness="0"
                                            Padding="12,8"
                                            VerticalOptions="Center">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.15" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowQrTicketCommand}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="🎫" FontSize="13" VerticalOptions="Center" />
                                            <Label Text="Vé QR" FontSize="12" FontAttributes="Bold" TextColor="#1E3A8A" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Training Points Progress -->
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="★ Điểm rèn luyện của bạn (Ban đầu: 0):"
                                               FontSize="12"
                                               TextColor="#CBD5E1" />
                                        <Label Grid.Column="1"
                                               Text="{Binding CurrentStudent.TrainingPoints, StringFormat='{0} ĐRL'}"
                                               FontSize="13.5"
                                               FontAttributes="Bold"
                                               TextColor="#34D399" />
                                    </Grid>

                                    <!-- Progress 1: Học kỳ (Mục tiêu 50đ) -->
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="Chỉ tiêu Học kỳ (Tối thiểu 50 ĐRL)" FontSize="11" TextColor="#CBD5E1" />
                                            <Label Grid.Column="1" Text="{Binding SemesterGoalDisplay}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding SemesterProgress}" ProgressColor="#10B981" HeightRequest="6" />
                                    </VerticalStackLayout>

                                    <!-- Progress 2: Năm học (Mục tiêu 250đ) -->
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="Chỉ tiêu Năm học (Tối thiểu 250 ĐRL)" FontSize="11" TextColor="#CBD5E1" />
                                            <Label Grid.Column="1" Text="{Binding YearGoalDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#60A5FA" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding YearProgress}" ProgressColor="#3B82F6" HeightRequest="6" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ============================================== -->
                        <!-- B. HERO CARD: QUẢN TRỊ VIÊN (ADMIN DASHBOARD)  -->
                        <!-- ============================================== -->
                        <Border IsVisible="{Binding IsAdmin}"
                                StrokeShape="RoundRectangle 22"
                                Padding="20"
                                StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E1B4B" Offset="0.0" />
                                    <GradientStop Color="#312E81" Offset="0.5" />
                                    <GradientStop Color="#4338CA" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource MidnightBlue}" Offset="0,8" Radius="20" Opacity="0.35" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 16" Background="#30FFFFFF" StrokeThickness="1.5" Stroke="#60FFFFFF">
                                        <Label Text="🛡️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="BẢNG ĐIỀU KHIỂN QUẢN TRỊ VIÊN" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" />
                                        <Label Text="{Binding CurrentStudent.FullName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                        <Label Text="Toàn quyền Quản lý • Duyệt hoạt động • Quản lý lớp" FontSize="11" TextColor="#CBD5E1" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Background="#EF4444" Padding="10,6">
                                        <Label Text="ADMIN" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Sự kiện" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding UpcomingCount}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Background="#30EF4444" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Chờ duyệt" FontSize="10" TextColor="#FCA5A5" HorizontalOptions="Center" />
                                            <Label Text="{Binding PendingApprovalCount}" FontSize="18" FontAttributes="Bold" TextColor="#FEE2E2" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Người dùng" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding TotalUsersCount}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ============================================== -->
                        <!-- C. HERO CARD: QUẢN LÝ SỰ KIỆN (EVENT MANAGER)  -->
                        <!-- ============================================== -->
                        <Border IsVisible="{Binding IsManager}"
                                StrokeShape="RoundRectangle 22"
                                Padding="20"
                                StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F172A" Offset="0.0" />
                                    <GradientStop Color="#1E3A8A" Offset="0.6" />
                                    <GradientStop Color="#2563EB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource MidnightBlue}" Offset="0,8" Radius="20" Opacity="0.35" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 16" Background="#30FFFFFF" StrokeThickness="1.5" Stroke="#60FFFFFF">
                                        <Label Text="🎪" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="BAN TỔ CHỨC &amp; QUẢN LÝ SỰ KIỆN" FontSize="11" FontAttributes="Bold" TextColor="#93C5FD" />
                                        <Label Text="{Binding CurrentStudent.FullName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                        <Label Text="Quản lý sự kiện do bạn tạo • Duyệt tham gia &amp; Check-in" FontSize="11" TextColor="#CBD5E1" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Background="#3B82F6" Padding="10,6">
                                        <Label Text="MANAGER" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="SK Của tôi" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding MyCreatedEventsCount}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Background="#30F59E0B" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Đơn chờ duyệt" FontSize="10" TextColor="#FDE68A" HorizontalOptions="Center" />
                                            <Label Text="{Binding PendingRegistrationsCount}" FontSize="18" FontAttributes="Bold" TextColor="#FEF3C7" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Tổng SK mở" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding UpcomingCount}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ============================================== -->
                        <!-- D. HERO CARD: GIẢNG VIÊN CỐ VẤN (LECTURER HUB) -->
                        <!-- ============================================== -->
                        <Border IsVisible="{Binding IsLecturer}"
                                StrokeShape="RoundRectangle 22"
                                Padding="20"
                                StrokeThickness="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#064E3B" Offset="0.0" />
                                    <GradientStop Color="#0F766E" Offset="0.6" />
                                    <GradientStop Color="#1E3A8A" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource MidnightBlue}" Offset="0,8" Radius="20" Opacity="0.35" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 16" Background="#30FFFFFF" StrokeThickness="1.5" Stroke="#60FFFFFF">
                                        <Label Text="👨‍🏫" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="CỐ VẤN HỌC TẬP &amp; GIẢNG VIÊN" FontSize="11" FontAttributes="Bold" TextColor="#A7F3D0" />
                                        <Label Text="{Binding CurrentStudent.FullName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                        <Label Text="{Binding AssignedClassDisplay, StringFormat='Chủ nhiệm Lớp: {0}'}" FontSize="11" TextColor="#CBD5E1" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Background="#10B981" Padding="10,6">
                                        <Label Text="GIẢNG VIÊN" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Lớp chủ nhiệm" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding AssignedClassDisplay}" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Sĩ số lớp" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="{Binding ClassStudentsCount, StringFormat='{0} SV'}" FontSize="17" FontAttributes="Bold" TextColor="#34D399" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20FFFFFF" StrokeShape="RoundRectangle 12" Padding="10,8" StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Quản lý lớp" FontSize="10" TextColor="#CBD5E1" HorizontalOptions="Center" />
                                            <Label Text="Hub" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Pending Events Alert Banner for Admin -->
                        <Border IsVisible="{Binding HasPendingApprovals}"
                                BackgroundColor="#FEF3C7" Stroke="#FCD34D" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToEventsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🛡️" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding PendingApprovalCount, StringFormat='Có {0} hoạt động mới đang chờ Admin phê duyệt.'}"
                                       FontSize="12.5" FontAttributes="Bold" TextColor="#92400E" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="Duyệt ngay →" FontSize="12" FontAttributes="Bold" TextColor="#B45309" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- ============================================== -->
                        <!-- 2. TIỆN ÍCH THAO TÁC NHANH (QUICK ACTIONS)     -->
                        <!-- ============================================== -->
                        <!-- Row 2.1: Quick Actions for Admin -->
                        <Grid IsVisible="{Binding IsAdmin}" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="6,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" Background="#EFF6FF" StrokeThickness="0" HorizontalOptions="Center">
                                        <Label Text="👥" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Người Dùng" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="6,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToEventsCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" Background="#FEF2F2" StrokeThickness="0" HorizontalOptions="Center">
                                        <Label Text="🛡️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Duyệt SK" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="6,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToAttendanceReportCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" Background="#ECFDF5" StrokeThickness="0" HorizontalOptions="Center">
                                        <Label Text="📊" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Báo Cáo" FontSize="11" FontAttributes="Bold" TextColor="#059669" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="3" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="6,12">
                                <Border.GestureRecognizers>
