                                    <TapGestureRecognizer Command="{Binding NavigateToClassHubCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" Background="#FAF5FF" StrokeThickness="0" HorizontalOptions="Center">
                                        <Label Text="🎓" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Lớp Học" FontSize="11" FontAttributes="Bold" TextColor="#7C3AED" HorizontalOptions="Center" />
                                </VerticalStackLayout>
