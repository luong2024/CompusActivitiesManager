                        </Grid>

                        <!-- ============================================== -->
                        <!-- 3. BẢNG THỐNG KÊ HOẠT ĐỘNG (2x2 RESPONSIVE)    -->
                        <!-- ============================================== -->
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                            <!-- Card 1: Sự kiện sắp tới -->
                            <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="SỰ KIỆN MỞ" FontSize="10.5" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding UpcomingCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                        <Label Text="Đang diễn ra" FontSize="11" TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="🎪" FontSize="26" VerticalOptions="Center" Opacity="0.8" />
                                </Grid>
                            </Border>

                            <!-- Card 2: Đã đăng ký -->
                            <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ĐÃ ĐĂNG KÝ" FontSize="10.5" FontAttributes="Bold" TextColor="#10B981" />
                                        <Label Text="{Binding RegisteredCount}" FontSize="24" FontAttributes="Bold" TextColor="#10B981" />
                                        <Label Text="Vé sẵn sàng" FontSize="11" TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="🎫" FontSize="26" VerticalOptions="Center" Opacity="0.8" />
                                </Grid>
                            </Border>

                            <!-- Card 3: Điểm rèn luyện -->
                            <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ĐIỂM RÈN LUYỆN" FontSize="10.5" FontAttributes="Bold" TextColor="#7C3AED" />
                                        <Label Text="{Binding CurrentStudent.TrainingPoints, StringFormat='{0} ⭐'}" FontSize="24" FontAttributes="Bold" TextColor="#7C3AED" />
                                        <Label Text="Kỳ 1 (2026)" FontSize="11" TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="🏆" FontSize="26" VerticalOptions="Center" Opacity="0.8" />
                                </Grid>
                            </Border>

                            <!-- Card 4: Xếp loại -->
                            <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 16"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="XẾP LOẠI" FontSize="10.5" FontAttributes="Bold" TextColor="#D97706" />
                                        <Label Text="{Binding CurrentStudent.PointRank}" FontSize="20" FontAttributes="Bold" TextColor="#D97706" />
                                        <Label Text="Thành tích cao" FontSize="11" TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="🏅" FontSize="26" VerticalOptions="Center" Opacity="0.8" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 4. THÔNG BÁO QUAN TRỌNG (CAMPUS NOTICES)       -->
                        <!-- ============================================== -->
                        <Border StrokeShape="RoundRectangle 16" Stroke="#DBEAFE" Background="#EFF6FF" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="📢" FontSize="20" Grid.Column="0" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Quy định Điểm Rèn Luyện (ĐRL) &amp; Check-in Điểm Danh" FontSize="13" FontAttributes="Bold" TextColor="#1E40AF" />
                                    <Label Text="Điểm ban đầu: 0 ĐRL. Mỗi kỳ cần tối thiểu 50 ĐRL, cả năm cần 250 ĐRL. Quét mã QR để mở thông tin hoạt động và điểm danh bằng ảnh!" FontSize="11.5" TextColor="#3B82F6" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- ============================================== -->
                        <!-- 5. DANH SÁCH SỰ KIỆN ĐANG MỞ (LIVE EVENTS)     -->
                        <!-- ============================================== -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="🔥 Hoạt động đang mở đăng ký" FontSize="16" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" 
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Xem tất cả ➔" 
                                    Command="{Binding NavigateToEventsCommand}" 
                                    Background="Transparent" 
                                    TextColor="{StaticResource Primary}" 
                                    FontSize="12" FontAttributes="Bold" Padding="0" HeightRequest="32" />
                        </Grid>

                        <!-- Category Filter Chips -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" Padding="12,6"
                                        BackgroundColor="{StaticResource Primary}">
                                    <Label Text="Tất cả" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="Tất cả" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border StrokeShape="RoundRectangle 20" Stroke="#DBEAFE" StrokeThickness="1" Padding="12,6" BackgroundColor="#EFF6FF">
                                    <Label Text="📘 Học thuật" FontSize="12" FontAttributes="Bold" TextColor="#2563EB" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="Học thuật" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border StrokeShape="RoundRectangle 20" Stroke="#D1FAE5" StrokeThickness="1" Padding="12,6" BackgroundColor="#ECFDF5">
                                    <Label Text="⚽ Thể thao" FontSize="12" FontAttributes="Bold" TextColor="#059669" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="Thể thao" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border StrokeShape="RoundRectangle 20" Stroke="#FEE2E2" StrokeThickness="1" Padding="12,6" BackgroundColor="#FEF2F2">
                                    <Label Text="🌿 Tình nguyện" FontSize="12" FontAttributes="Bold" TextColor="#DC2626" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="Tình nguyện" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border StrokeShape="RoundRectangle 20" Stroke="#F3E8FF" StrokeThickness="1" Padding="12,6" BackgroundColor="#FAF5FF">
                                    <Label Text="💡 Kỹ năng mềm" FontSize="12" FontAttributes="Bold" TextColor="#7C3AED" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="Kỹ năng mềm" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Event Cards (Horizontal Carousel) -->
                        <ScrollView Orientation="Horizontal" Margin="-16,0" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="14" Padding="16,4" BindableLayout.ItemsSource="{Binding DisplayEvents}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CampusEvent">
                                        <Border StrokeShape="RoundRectangle 18"
                                                WidthRequest="250"
                                                Padding="16"
                                                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="10" Opacity="0.06" />
                                            </Border.Shadow>

                                            <VerticalStackLayout Spacing="10">
                                                <!-- Cover Image & Video Badge -->
                                                <Grid HeightRequest="110" HorizontalOptions="FillAndExpand">
                                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#E2E8F0">
                                                        <Image Source="{Binding PrimaryImageUrl}" Aspect="AspectFill" HeightRequest="110" HorizontalOptions="FillAndExpand" />
                                                    </Border>

                                                    <Border IsVisible="{Binding HasVideo}"
                                                            HorizontalOptions="End" VerticalOptions="End" Margin="6"
                                                            StrokeShape="RoundRectangle 10" BackgroundColor="#CCDC2626" StrokeThickness="0" Padding="8,4">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=OpenVideoCommand, x:DataType=pageModels:MainPageModel}" 
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <Label Text="▶" TextColor="{StaticResource White}" FontSize="10" VerticalOptions="Center" />
                                                            <Label Text="Video" TextColor="{StaticResource White}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <!-- Category Tag & Points Tag -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10"
                                                            Padding="8,4"
                                                            BackgroundColor="{Binding CategoryTagBg}"
                                                            Stroke="{Binding CategoryTagBorderColor}"
                                                            StrokeThickness="1"
                                                            HorizontalOptions="Start">
                                                        <Label Text="{Binding CategoryTitle}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding CategoryTagTextColor}" />
                                                    </Border>

                                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Background="#ECFDF5" Padding="6,2">
                                                        <Label Text="{Binding TrainingPointsRewardDisplay}" FontSize="10" FontAttributes="Bold" TextColor="#059669" />
                                                    </Border>
                                                </Grid>

                                                <!-- Activity Title -->
                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />

                                                <!-- Description -->
                                                <Label Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />

                                                <!-- Location and Date -->
                                                <Label Text="{Binding TimeLocationDisplay}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                                <!-- Primary Action: View Details / Register -->
                                                <Button Text="🔍 Chi tiết / Đăng ký"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        HeightRequest="38"
                                                        CornerRadius="10"
                                                        Background="{StaticResource PrimaryGradientBrush}"
                                                        TextColor="{StaticResource White}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=OpenEventDetailCommand, x:DataType=pageModels:MainPageModel}"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Shadow>
                                                        <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.2" />
                                                    </Button.Shadow>
                                                </Button>

                                                <!-- Check-in Action -->
                                                <Button Text="📸 Điểm danh ảnh"
                                                        FontSize="11" FontAttributes="Bold"
                                                        HeightRequest="34" CornerRadius="8" Padding="4,0"
                                                        BackgroundColor="#FEF3C7" TextColor="#B45309"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=CheckInWithPhotoCommand, x:DataType=pageModels:MainPageModel}"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- ============================================== -->
                        <!-- 6. HOẠT ĐỘNG ĐÃ ĐĂNG KÝ CỦA TÔI (MY EVENTS)   -->
                        <!-- ============================================== -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="🎫 Hoạt động đã đăng ký của bạn" FontSize="16" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            <Label Grid.Column="1" Text="{Binding RegisteredCount, StringFormat='{0} hoạt động'}" FontSize="12" 
                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding MyRegisteredEvents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CampusEvent">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            Padding="14">
                                        <VerticalStackLayout Spacing="10">
                                            <!-- Row 1: Event Icon + Info -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" Background="#EFF6FF" StrokeThickness="0" VerticalOptions="Center">
                                                    <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontSize="13.5" FontAttributes="Bold" 
                                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" 
                                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                                    <Label Text="{Binding TimeLocationDisplay}" FontSize="11" 
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- Row 2: Attendance Actions -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button Grid.Column="0" Text="🎫 Xem Vé QR" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=ShowQrTicketCommand, x:DataType=pageModels:MainPageModel}" 
                                                        CommandParameter="{Binding .}"
                                                        HeightRequest="36" 
                                                        CornerRadius="10" 
                                                        FontSize="11.5" 
                                                        FontAttributes="Bold" 
                                                        Background="{StaticResource PrimaryGradientBrush}" 
                                                        TextColor="{StaticResource White}" />

                                                <Button Grid.Column="1" Text="📸 Điểm Danh Ảnh" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=CheckInWithPhotoCommand, x:DataType=pageModels:MainPageModel}" 
                                                        CommandParameter="{Binding .}"
                                                        HeightRequest="36" 
                                                        CornerRadius="10" 
                                                        FontSize="11.5" 
                                                        FontAttributes="Bold" 
                                                        BackgroundColor="#FEF3C7" 
                                                        TextColor="#B45309" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>

        <!-- ============================================== -->
        <!-- 7. STUDENT QR ATTENDANCE TICKET MODAL          -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              BackgroundColor="#90000000"
              IsVisible="{Binding IsQrModalVisible}"
              Padding="16"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseQrTicketCommand}" />
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 24"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkBackground}}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340"
                    Margin="16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,10" Radius="30" Opacity="0.35" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="14" HorizontalOptions="FillAndExpand">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Vé Điểm Danh QR" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Background="Transparent" TextColor="{StaticResource Gray500}" WidthRequest="32" HeightRequest="32" Padding="0" Command="{Binding CloseQrTicketCommand}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- QR Code Card -->
                    <Border StrokeShape="RoundRectangle 18"
                            Background="{StaticResource White}"
                            Padding="18"
                            StrokeThickness="2"
                            Stroke="{StaticResource Primary}"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border WidthRequest="180" HeightRequest="180" Background="{StaticResource White}" StrokeShape="RoundRectangle 12" Padding="8" StrokeThickness="1" Stroke="{StaticResource Gray200}">
                                <Image Source="{Binding QrImageSource}"
                                       Aspect="AspectFit"
                                       WidthRequest="164"
                                       HeightRequest="164"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Text="{Binding QrTicketCode}"
                                   FontSize="10.5"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ticket Details -->
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentStudent.FullName}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentStudent.StudentCode, StringFormat='MSV: {0}'}" FontSize="11.5" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" />
                        <Label Text="{Binding SelectedActivityForQr}" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                    </VerticalStackLayout>

                    <Button Text="Đóng vé"
                            Background="{StaticResource PrimaryGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            HeightRequest="42"
                            CornerRadius="12"
                            Command="{Binding CloseQrTicketCommand}">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.25" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>


        <!-- ============================================== -->
        <!-- 8. IN-APP NOTIFICATIONS MODAL / DRAWER         -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              BackgroundColor="#90000000"
              IsVisible="{Binding IsNotificationsModalVisible}"
              Padding="16"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseNotificationsModalCommand}" />
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 24"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkBackground}}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420"
                    MaximumHeightRequest="560"
                    Margin="16"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,10" Radius="30" Opacity="0.35" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="🔔 Thông Báo" FontSize="16" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                   VerticalOptions="Center" />
                            <Border IsVisible="{Binding HasUnreadNotifications}"
                                    BackgroundColor="#EF4444" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" VerticalOptions="Center">
                                <Label Text="{Binding UnreadNotificationsCount, StringFormat='{0} mới'}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>

                        <Button Grid.Column="1" Text="Đã đọc hết" FontSize="11" TextColor="{StaticResource Primary}"
                                Background="Transparent" Padding="4,0" HeightRequest="30"
                                Command="{Binding MarkAllNotificationsAsReadCommand}" />

                        <Button Grid.Column="2" Text="✕" Background="Transparent" TextColor="{StaticResource Gray500}"
                                WidthRequest="32" HeightRequest="32" Padding="0" Command="{Binding CloseNotificationsModalCommand}" />
                    </Grid>

                    <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Notifications List -->
                    <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notifications}" Spacing="8">
                            <BindableLayout.EmptyView>
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,30">
                                    <Label Text="📭" FontSize="36" HorizontalOptions="Center" />
                                    <Label Text="Không có thông báo mới" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                    <Label Text="Mọi biến động điểm rèn luyện, đăng ký sự kiện và nhắc nhở sẽ hiển thị tại đây."
                                           FontSize="11" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CampusNotificationDto">
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                            Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=MarkNotificationAsReadCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#EFF6FF" StrokeThickness="0" VerticalOptions="Start">
                                                <Label Text="{Binding TypeIcon}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                           LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#EF4444"
                                                             IsVisible="{Binding IsUnread}"
                                                             VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Message}" FontSize="11.5"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding FormattedTime}" FontSize="10" TextColor="{StaticResource Gray400}" Margin="0,2,0,0" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2" Text="✓" FontSize="11" Background="Transparent" TextColor="{StaticResource Primary}"
                                                    WidthRequest="28" HeightRequest="28" Padding="0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=MarkNotificationAsReadCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding IsUnread}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button Grid.Row="3" Text="Đóng thông báo"
                            Background="{StaticResource PrimaryGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            CornerRadius="12"
                            Command="{Binding CloseNotificationsModalCommand}" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
