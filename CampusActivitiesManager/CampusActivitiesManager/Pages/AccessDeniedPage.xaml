<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             x:DataType="pageModels:AccessDeniedViewModel"
             x:Class="CampusActivitiesManager.Pages.AccessDeniedPage"
             Title="{Binding Title}">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="{StaticResource LayoutPadding}">
        <Border StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light=#FECACA, Dark=#7F1D1D}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                Padding="32"
                WidthRequest="420"
                HorizontalOptions="Center">

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                <!-- Lock / Warning Icon -->
                <Border HeightRequest="80"
                        WidthRequest="80"
                        StrokeShape="RoundRectangle 40"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        HorizontalOptions="Center">
                    <Label Text="🔒" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Từ chối Truy cập!"
                           Style="{StaticResource Title2}"
                           TextColor="#DC2626"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding Reason}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label Text="Bạn không có quyền thực hiện hành động này hoặc truy cập trang quản trị. Vui lòng liên hệ Quản trị viên (Admin) để được cấp quyền."
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       HorizontalTextAlignment="Center" />

                <!-- Action Button -->
                <Button Text="🏠 Về Trang Chủ"
                        Command="{Binding GoHomeCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
