<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pagemodels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             x:Class="CampusActivitiesManager.Pages.QrScannerPage"
             x:DataType="pagemodels:QrScannerViewModel"
             Title="Quét QR Điểm Danh"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header Card -->
            <Border StrokeShape="RoundRectangle 20"
                    Background="{StaticResource PrimaryGradientBrush}"
                    Padding="20"
                    StrokeThickness="0">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="📷" FontSize="22" VerticalOptions="Center" />
                        <Label Text="Quét Mã QR Check-in"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Quét mã QR trên vé điện tử hoặc hội trường để ghi nhận điểm danh và nhận điểm rèn luyện."
                           FontSize="12.5"
                           TextColor="#E0E7FF"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Event Selector -->
            <Border StrokeShape="RoundRectangle 16"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    Padding="16,12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="CHỌN SỰ KIỆN ĐIỂM DANH"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Picker Title="-- Chọn sự kiện cần check-in --"
                            ItemsSource="{Binding ActiveEvents}"
                            ItemDisplayBinding="{Binding Name, x:DataType='models:CampusEvent'}"
                            SelectedItem="{Binding SelectedEvent}"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            FontSize="13.5" />
                </VerticalStackLayout>
            </Border>

            <!-- Scanner Viewfinder Box -->
            <Border StrokeShape="RoundRectangle 24"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    Padding="24"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                    <!-- Viewfinder Frame -->
                    <Border WidthRequest="200"
                            HeightRequest="200"
                            StrokeShape="RoundRectangle 20"
                            Background="#0F172A"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            Padding="16"
                            HorizontalOptions="Center">
                        <Grid>
                            <!-- Corner Targets -->
                            <BoxView WidthRequest="20" HeightRequest="4" Color="{StaticResource Primary}" HorizontalOptions="Start" VerticalOptions="Start" />
                            <BoxView WidthRequest="4" HeightRequest="20" Color="{StaticResource Primary}" HorizontalOptions="Start" VerticalOptions="Start" />

                            <BoxView WidthRequest="20" HeightRequest="4" Color="{StaticResource Primary}" HorizontalOptions="End" VerticalOptions="Start" />
                            <BoxView WidthRequest="4" HeightRequest="20" Color="{StaticResource Primary}" HorizontalOptions="End" VerticalOptions="Start" />

                            <BoxView WidthRequest="20" HeightRequest="4" Color="{StaticResource Primary}" HorizontalOptions="Start" VerticalOptions="End" />
                            <BoxView WidthRequest="4" HeightRequest="20" Color="{StaticResource Primary}" HorizontalOptions="Start" VerticalOptions="End" />

                            <BoxView WidthRequest="20" HeightRequest="4" Color="{StaticResource Primary}" HorizontalOptions="End" VerticalOptions="End" />
                            <BoxView WidthRequest="4" HeightRequest="20" Color="{StaticResource Primary}" HorizontalOptions="End" VerticalOptions="End" />

                            <!-- Center Camera / Scan Icon -->
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                <Label Text="🎯" FontSize="40" HorizontalOptions="Center" />
                                <Label Text="Hướng camera vào mã QR"
                                       FontSize="11"
                                       TextColor="#94A3B8"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Manual Input / Fast Simulate Test -->
                    <VerticalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                        <Label Text="Hoặc dán / nhập mã vé QR:"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="Ví dụ: CAMPUS|EVT:1|STU:B20DCCN001..."
                                   Text="{Binding QrInput}"
                                   FontSize="12"
                                   ClearButtonVisibility="WhileEditing" />
                            <Button Grid.Column="1"
                                    Text="Check-in"
                                    Command="{Binding ProcessQrCodeCommand}"
                                    Background="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="42"
                                    Padding="14,0" />
                        </Grid>

                        <!-- Fast Test Simulation Button -->
                        <Button Text="⚡ Quét Giả Lập Tức Thì (1-Click Test)"
                                Command="{Binding SimulateQuickScanCommand}"
                                Background="{StaticResource PrimaryGradientBrush}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                CornerRadius="12">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Result Card -->
            <Border StrokeShape="RoundRectangle 20"
                    IsVisible="{Binding HasResult}"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                    Stroke="#16A34A"
                    StrokeThickness="1.5"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🎉" FontSize="26" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Ghi Nhận Điểm Danh Thành Công"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A" />
                            <Label Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Sinh viên:" FontSize="12.5" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding LastRecord.StudentName}" FontSize="12.5" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Mã số sinh viên:" FontSize="12.5" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding LastRecord.StudentCode}" FontSize="12.5" FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Điểm rèn luyện:" FontSize="12.5" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding LastRecord.PointsDisplay}" FontSize="12.5" FontAttributes="Bold" TextColor="#16A34A" />
                    </Grid>

                    <Button Text="Tiếp tục quét mã khác"
                            Command="{Binding ResetScanCommand}"
                            Background="#F1F5F9"
                            TextColor="{StaticResource DarkOnLightBackground}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
