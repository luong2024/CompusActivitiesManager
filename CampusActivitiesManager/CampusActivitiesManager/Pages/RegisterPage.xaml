<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="pageModels:RegisterViewModel"
             x:Class="CampusActivitiesManager.Pages.RegisterPage"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24,32" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Logo & Title Header -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 20" StrokeThickness="0" Background="{StaticResource PrimaryGradientBrush}" HorizontalOptions="Center" Padding="0">
                    <Label Text="🎓" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Đăng Ký Tài Khoản Sinh Viên" Style="{StaticResource Title2}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Tạo tài khoản tham gia hoạt động campus và rèn luyện kỹ năng" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Form Đăng ký -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="26">
                <VerticalStackLayout Spacing="16">

                    <!-- Error Alert -->
                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource ErrorBorderLight}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBgLight}, Dark={StaticResource ErrorBgDark}}"
                            Padding="12,10"
                            IsVisible="{Binding HasError}">
                        <Label AutomationId="lblRegisterError" Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorDark}" FontSize="13" />
                    </Border>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Họ và Tên Sinh Viên *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry AutomationId="txtRegisterFullName" Text="{Binding FullName}" Placeholder="Ví dụ: Nguyễn Văn An" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Username / Student Code -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mã Số Sinh Viên (MSSV / Tên đăng nhập) *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry AutomationId="txtRegisterUsername" Text="{Binding Username}" Placeholder="Ví dụ: B20DCCN001" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Địa Chỉ Email *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry AutomationId="txtRegisterEmail" Text="{Binding Email}" Placeholder="sinhvien@campus.edu.vn" Keyboard="Email" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Phone Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Số Điện Thoại" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Entry AutomationId="txtRegisterPhone" Text="{Binding PhoneNumber}" Placeholder="Ví dụ: 0912345678" Keyboard="Telephone" FontSize="14" HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Class Selection -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Lớp Sinh Hoạt *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2">
                            <Picker AutomationId="pickerRegisterClass"
                                    ItemsSource="{Binding AvailableClasses}"
                                    SelectedItem="{Binding SelectedClass}"
                                    Title="Chọn lớp sinh hoạt"
                                    FontSize="14"
                                    HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Mật khẩu *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                            <Label Grid.Column="1" Text="{Binding PasswordStrength}" TextColor="{Binding PasswordStrengthColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2,4,2">
                            <Grid ColumnDefinitions="*,40">
                                <Entry AutomationId="txtRegisterPassword"
                                       Grid.Column="0"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       Placeholder="Tối thiểu 6 ký tự"
                                       FontSize="14"
                                       HeightRequest="42" />
                                <ImageButton AutomationId="btnToggleRegisterPassword"
                                             Grid.Column="1"
                                             Command="{Binding TogglePasswordVisibilityCommand}"
                                             BackgroundColor="Transparent"
                                             HeightRequest="38" WidthRequest="38"
                                             Padding="8"
                                             Opacity="0.65">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="True">
                                            <Setter Property="Source" Value="eye_off.png" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="False">
                                            <Setter Property="Source" Value="eye_on.png" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Xác nhận Mật khẩu *" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource LabelTextLight}, Dark={StaticResource LabelTextDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Padding="12,2,4,2">
                            <Grid ColumnDefinitions="*,40">
                                <Entry AutomationId="txtRegisterConfirmPassword"
                                       Grid.Column="0"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="{Binding IsConfirmPasswordHidden}"
                                       Placeholder="Nhập lại mật khẩu"
                                       FontSize="14"
                                       HeightRequest="42" />
                                <ImageButton AutomationId="btnToggleRegisterConfirmPassword"
                                             Grid.Column="1"
                                             Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                             BackgroundColor="Transparent"
                                             HeightRequest="38" WidthRequest="38"
                                             Padding="8"
                                             Opacity="0.65">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsConfirmPasswordHidden}" Value="True">
                                            <Setter Property="Source" Value="eye_off.png" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsConfirmPasswordHidden}" Value="False">
                                            <Setter Property="Source" Value="eye_on.png" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Training Points Rules Banner -->
                    <Border StrokeShape="RoundRectangle 12"
                            Background="{AppThemeBinding Light=#EFF6FF, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light=#BFDBFE, Dark={StaticResource Gray700}}"
                            StrokeThickness="1"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="3">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                                <Label Text="Quy định Điểm Rèn Luyện (ĐRL):" FontSize="12.5" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                            <Label Text="• Điểm khởi điểm ban đầu: 0 ĐRL" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Label Text="• Điều kiện đạt mỗi kỳ: Tối thiểu 50 ĐRL" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Label Text="• Điều kiện đạt một năm: Tối thiểu 250 ĐRL" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Register Button -->
                    <Button AutomationId="btnRegisterSubmit"
                            Text="Đăng Ký Tài Khoản"
                            Command="{Binding RegisterCommand}"
                            Background="{StaticResource PrimaryGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="48"
                            CornerRadius="12"
                            Margin="0,6,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Text" Value="Đang đăng ký..." />
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="False">
                                <Setter Property="Text" Value="Đăng Ký Tài Khoản" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Go back to login -->
                    <Button AutomationId="btnBackToLogin"
                            Text="Đã có tài khoản? Quay lại đăng nhập"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            FontSize="13"
                            Margin="0,2,0,0" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
