<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             x:Class="CampusActivitiesManager.Pages.RegisterPage"
             x:DataType="pageModels:RegisterPageModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Title="Đăng ký tài khoản">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="{OnIdiom '20,24', Desktop='40,50'}"
              VerticalOptions="CenterAndExpand"
              HorizontalOptions="Center"
              MaximumWidthRequest="540">

            <Border StrokeShape="RoundRectangle 28"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    Padding="{OnIdiom '24,28', Desktop='36,40'}">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                            Offset="0,10"
                            Radius="30"
                            Opacity="{AppThemeBinding Light=0.15, Dark=0.4}" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <!-- Header -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tạo tài khoản sinh viên"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Label Text="Gia nhập cộng đồng sinh viên và tham gia các hoạt động campus"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>

                    <!-- Error Alert Banner -->
                    <Border Background="#FEF2F2"
                            StrokeThickness="1"
                            Stroke="#EF4444"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,10"
                            IsVisible="{Binding HasError}">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#DC2626"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Field: Full Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Họ và tên sinh viên / Cán bộ"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                Padding="14,0"
                                HeightRequest="48">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{StaticResource IconPerson}"
                                       WidthRequest="20" HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding FullName}"
                                       Placeholder="Ví dụ: Nguyễn An Cương"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Row: Student Code & Class -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Mã sinh viên (MSV)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding StudentCode}"
                                       Placeholder="B20DCCN001"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Lớp sinh hoạt"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding ClassName}"
                                       Placeholder="D20CNTT1"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Field: Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Địa chỉ Email"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                Padding="14,0"
                                HeightRequest="48">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{StaticResource IconMail}"
                                       WidthRequest="20" HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       Placeholder="cuong.na@campus.edu.vn"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Field: Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                Padding="14,0"
                                HeightRequest="48">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{StaticResource IconLock}"
                                       WidthRequest="20" HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       Placeholder="Tối thiểu 6 ký tự..."
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        ImageSource="{Binding IsPasswordHidden, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource IconEye}, FalseObject={StaticResource IconEyeOff}}}"
                                        Background="Transparent"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        SemanticProperties.Description="Ẩn hoặc hiện mật khẩu" />
                            </Grid>
                        </Border>

                        <!-- Dynamic Password Strength Indicator Bar -->
                        <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
                            <ProgressBar Progress="{Binding PasswordStrengthPercent}"
                                         ProgressColor="{Binding PasswordStrengthColor}"
                                         HeightRequest="4"
                                         VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PasswordStrengthText}"
                                   FontSize="11"
                                   TextColor="{Binding PasswordStrengthColor}"
                                   Margin="8,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Field: Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Xác nhận mật khẩu"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}"
                                Padding="14,0"
                                HeightRequest="48">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{StaticResource IconLock}"
                                       WidthRequest="20" HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="{Binding IsConfirmPasswordHidden}"
                                       Placeholder="Nhập lại mật khẩu..."
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        ImageSource="{Binding IsConfirmPasswordHidden, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource IconEye}, FalseObject={StaticResource IconEyeOff}}}"
                                        Background="Transparent"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                        SemanticProperties.Description="Ẩn hoặc hiện mật khẩu xác nhận" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- AC 1.4: Terms & Conditions Checkbox -->
                    <HorizontalStackLayout Spacing="8" Margin="0,2">
                        <CheckBox IsChecked="{Binding AgreeToTerms}"
                                  Color="{StaticResource Primary}"
                                  VerticalOptions="Center" />
                        <Label FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center"
                               Text="Tôi đồng ý với Điều khoản &amp; Quy định sử dụng">
                        </Label>
                    </HorizontalStackLayout>

                    <!-- AC 1.2: Primary Register Button -->
                    <Button Text="{Binding IsLoading, Converter={toolkit:BoolToObjectConverter TrueObject='Đang tạo tài khoản...', FalseObject='Đăng Ký Tài Khoản'}}"
                            Background="{StaticResource PrimaryGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="52"
                            CornerRadius="16"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            Command="{Binding RegisterCommand}">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="16" Opacity="0.35" />
                        </Button.Shadow>
                    </Button>

                    <!-- AC 1.3: Link to Login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,0">
                        <Label Text="Đã có tài khoản?"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Text="Đăng nhập ngay"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
