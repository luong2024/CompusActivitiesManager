<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusActivitiesManager.Pages.ManageCategoryPage"
             Title="Manage Categories">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Categories Management" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <ListView ItemsSource="{Binding Categories}" HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Refresh Categories" Command="{Binding RefreshCommand}" />
    </VerticalStackLayout>
</ContentPage>
