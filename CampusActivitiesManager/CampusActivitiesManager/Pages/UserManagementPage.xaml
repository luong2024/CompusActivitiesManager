<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             x:DataType="pageModels:UserManagementPageModel"
             x:Class="CampusActivitiesManager.Pages.UserManagementPage"
             x:Name="ThisPage"
             Title="Quản lý &amp; Phân quyền">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ThisPage}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Làm mới" Command="{Binding LoadUsersCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Main Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="{StaticResource LayoutPadding}">

                <!-- Header Profile Info & Quick Status -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Hệ thống Phân quyền Truy cập (RBAC)" Style="{StaticResource Title2}" />
                        <Label Text="Quản lý tài khoản và phân cấp vai trò người dùng trong hệ thống" Style="{StaticResource Caption1}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E293B}" Padding="10,6">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="👤" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding CurrentUserRoleName}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4F46E5, Dark=#818CF8}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Non-Admin Warning Banner (Hiển thị khi không phải Admin) -->
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="#F59E0B"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#451A03}"
                        Padding="14,10"
                        IsVisible="{Binding IsAdmin, Converter={toolkit:InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="20" Grid.Column="0" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Chế độ chỉ xem (View-Only Mode)" FontAttributes="Bold" TextColor="#B45309" FontSize="14" />
                            <Label Text="Tài khoản hiện tại không có quyền Quản trị viên (Admin). Bạn chỉ có thể xem danh sách phân quyền."
                                   TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 4 Thẻ Thống kê Số lượng Tài khoản -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <!-- Total -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TỔNG SỐ" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="{Binding TotalUsersCount}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            <Label Text="Tài khoản" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Admin -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ADMIN" FontSize="11" FontAttributes="Bold" TextColor="#DC2626" />
                            <Label Text="{Binding AdminCount}" FontSize="24" FontAttributes="Bold" TextColor="#DC2626" />
                            <Label Text="Quản trị viên" FontSize="11" TextColor="#EF4444" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Manager -->
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MANAGER" FontSize="11" FontAttributes="Bold" TextColor="#2563EB" />
                            <Label Text="{Binding ManagerCount}" FontSize="24" FontAttributes="Bold" TextColor="#2563EB" />
                            <Label Text="Quản lý" FontSize="11" TextColor="#3B82F6" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- User/Student -->
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#052E16}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="USER / SV" FontSize="11" FontAttributes="Bold" TextColor="#16A34A" />
                            <Label Text="{Binding UserCount}" FontSize="24" FontAttributes="Bold" TextColor="#16A34A" />
                            <Label Text="Sinh viên" FontSize="11" TextColor="#22C55E" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tìm kiếm & Bộ lọc Vai trò -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <SearchBar Text="{Binding SearchText}"
                               Placeholder="Tìm theo họ tên, username, email, khoa..."
                               Grid.Column="0"
                               HeightRequest="44" />

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button Text="Tất cả"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="All"
                                HeightRequest="36" Padding="12,0" FontSize="12"
                                BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}" />
                        <Button Text="Admin"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="Admin"
                                HeightRequest="36" Padding="12,0" FontSize="12"
                                BackgroundColor="#DC2626" TextColor="White" />
                        <Button Text="Manager"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="Manager"
                                HeightRequest="36" Padding="12,0" FontSize="12"
                                BackgroundColor="#2563EB" TextColor="White" />
                        <Button Text="User"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="User"
                                HeightRequest="36" Padding="12,0" FontSize="12"
                                BackgroundColor="#16A34A" TextColor="White" />
                        
                        <!-- Add Account Button -->
                        <Button Text="+ Thêm tài khoản"
                                Command="{Binding NavigateToCreateUserPageCommand}"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontAttributes="Bold"
                                Padding="16,0"
                                HeightRequest="44"
                                CornerRadius="8"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Danh sách Người dùng (CollectionView) -->
                <Label Text="Danh sách Tài khoản &amp; Vai trò" Style="{StaticResource Title3}" Margin="0,6,0,0" />

                <CollectionView ItemsSource="{Binding FilteredUsers}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" Padding="30" HorizontalOptions="Center">
                            <Label Text="🔍" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="Không tìm thấy người dùng nào phù hợp" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                    <!-- Thông tin Người dùng & Role Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Avatar Circle -->
                                        <Border Grid.Column="0"
                                                HeightRequest="48"
                                                WidthRequest="48"
                                                StrokeShape="RoundRectangle 24"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding RoleBadgeColor}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding AvatarInitials}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- User Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Label Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       TextColor="{Binding StatusColorHex}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Username, StringFormat='@{0}'}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                            <Label Text="{Binding Email}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                            <Label Text="{Binding Department}"
                                                   FontSize="12"
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                        </VerticalStackLayout>

                                        <!-- Role Badge Pill -->
                                        <Border Grid.Column="2"
                                                StrokeShape="RoundRectangle 16"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding RoleBadgeColor}"
                                                Padding="10,4"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding RoleShortName}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Nút Thao tác Phân quyền & Quản trị -->
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <!-- Nút Phân quyền chính (AC 05.3.1) -->
                                        <Button Grid.Column="0"
                                                Text="⚡ Phân quyền"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="12,0"
                                                BackgroundColor="#4F46E5"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                Command="{Binding SelectUserForRoleAssignmentCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                CommandParameter="{Binding .}" />

                                        <!-- Nút Đổi nhanh ActionSheet -->
                                        <Button Grid.Column="1"
                                                Text="Đổi nhanh"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="10,0"
                                                BackgroundColor="{AppThemeBinding Light=#E0E7FF, Dark=#312E81}"
                                                TextColor="{AppThemeBinding Light=#3730A3, Dark=#C7D2FE}"
                                                Command="{Binding QuickChangeRoleActionSheetCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                CommandParameter="{Binding .}" />

                                        <!-- Nút Trang Edit chi tiết (QueryProperty) -->
                                        <Button Grid.Column="2"
                                                Text="Chi tiết"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="10,0"
                                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#F9FAFB}"
                                                Command="{Binding NavigateToEditRolePageCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                CommandParameter="{Binding .}" />

                                        <!-- Nút Khóa / Mở tài khoản -->
                                        <Button Grid.Column="3"
                                                Text="{Binding IsActive, Converter={toolkit:BoolToObjectConverter TrueObject='Khóa', FalseObject='Mở khóa'}}"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="10,0"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                                                TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}"
                                                Command="{Binding ToggleUserStatusCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                CommandParameter="{Binding .}" />

                                        <!-- Nút Xóa tài khoản -->
                                        <Button Grid.Column="4"
                                                Text="Xóa"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="10,0"
                                                BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}"
                                                TextColor="{AppThemeBinding Light=#991B1B, Dark=#FECACA}"
                                                Command="{Binding DeleteUserCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Modal Dialog Phân quyền (AC 05.3.1) -->
        <Grid BackgroundColor="#80000000"
              IsVisible="{Binding IsRoleModalVisible}"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    Padding="24"
                    WidthRequest="450"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="⚡ Phân quyền Người dùng" Style="{StaticResource Title3}" />
                            <Label Text="{Binding SelectedUser.FullName, StringFormat='Tài khoản: {0}'}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#4F46E5, Dark=#818CF8}" />
                            <Label Text="{Binding SelectedUser.Username, StringFormat='Tên đăng nhập: @{0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                FontSize="14"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                Command="{Binding CloseRoleModalCommand}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                    <!-- Role Selection Options -->
                    <Label Text="Chọn vai trò mới cho tài khoản:" FontAttributes="Bold" FontSize="13" />

                    <!-- Option 1: Admin -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#FECACA, Dark=#7F1D1D}"
                            BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Admin}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Admin" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Admin (Quản trị viên)" FontAttributes="Bold" TextColor="#DC2626" FontSize="14" />
                                <Label Text="Toàn quyền trên hệ thống, phân quyền và quản lý tài khoản người dùng." FontSize="11" TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 2: Manager -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A8A}"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Manager}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Manager" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Manager (Quản lý hoạt động)" FontAttributes="Bold" TextColor="#2563EB" FontSize="14" />
                                <Label Text="Quản lý dự án, hoạt động và nhiệm vụ. Chế độ chỉ xem trong module người dùng." FontSize="11" TextColor="{AppThemeBinding Light=#1E40AF, Dark=#93C5FD}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 3: User / Student -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#BBF7D0, Dark=#14532D}"
                            BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#052E16}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.User}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="User" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="User (Sinh viên / Thành viên)" FontAttributes="Bold" TextColor="#16A34A" FontSize="14" />
                                <Label Text="Xem danh sách hoạt động, nhận nhiệm vụ và cập nhật tiến độ cá nhân." FontSize="11" TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 4: Guest -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#111827}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Guest}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Guest" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Guest (Khách vãng lai)" FontAttributes="Bold" TextColor="#6B7280" FontSize="14" />
                                <Label Text="Chỉ xem nội dung công khai, không thể thực hiện chỉnh sửa." FontSize="11" TextColor="{AppThemeBinding Light=#4B5563, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Modal Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                                TextColor="{AppThemeBinding Light=#374151, Dark=#F9FAFB}"
                                Command="{Binding CloseRoleModalCommand}"
                                HeightRequest="44" />

                        <Button Grid.Column="1"
                                Text="Lưu phân quyền"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                Command="{Binding SaveRoleAssignmentCommand}"
                                HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
