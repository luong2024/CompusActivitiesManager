<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             xmlns:models="clr-namespace:CampusActivitiesManager.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             x:DataType="pageModels:UserManagementPageModel"
             x:Class="CampusActivitiesManager.Pages.UserManagementPage"
             x:Name="ThisPage"
             Title="Quản lý &amp; Phân quyền">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ThisPage}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Làm mới" Command="{Binding LoadUsersCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Main Content: CollectionView with Header (Eliminates ScrollView-CollectionView nesting to prevent Android ANR) -->
        <CollectionView ItemsSource="{Binding FilteredUsers}"
                        SelectionMode="None"
                        >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="{StaticResource LayoutPadding}">

                <!-- Header Profile Info & Quick Status -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Hệ thống Phân quyền Truy cập (RBAC)" Style="{StaticResource Title2}" />
                        <Label Text="Quản lý tài khoản và phân cấp vai trò người dùng trong hệ thống" Style="{StaticResource Caption1}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondaryBackground}}" Padding="10,6">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="👤" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding CurrentUserRoleName}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource InfoTextDark}}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Non-Admin Warning Banner (Hiển thị khi không phải Admin) -->
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource WarningColor}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource WarningBgLight}, Dark={StaticResource WarningBgDark}}"
                        Padding="14,10"
                        IsVisible="{Binding IsAdmin, Converter={toolkit:InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="20" Grid.Column="0" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Chế độ chỉ xem (View-Only Mode)" FontAttributes="Bold" TextColor="{StaticResource WarningTextLight}" FontSize="14" />
                            <Label Text="Tài khoản hiện tại không có quyền Quản trị viên (Admin). Bạn chỉ có thể xem danh sách phân quyền."
                                   TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 4 Thẻ Thống kê Số lượng Tài khoản (2x2 Responsive Grid) -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                    <!-- Total -->
                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TỔNG TÀI KHOẢN" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="{Binding TotalUsersCount}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            <Label Text="Toàn hệ thống" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Admin -->
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource ErrorBorderLight}, Dark={StaticResource ErrorBorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBgLight}, Dark={StaticResource ErrorBgDark}}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ADMIN" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource ErrorDark}" />
                            <Label Text="{Binding AdminCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource ErrorDark}" />
                            <Label Text="Toàn quyền" FontSize="11" TextColor="{StaticResource ErrorColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Manager -->
                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource InfoBorderLight}, Dark={StaticResource InfoBorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource InfoBgLight}, Dark={StaticResource InfoBgDark}}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MANAGER" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding ManagerCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Tổ chức sự kiện" FontSize="11" TextColor="{StaticResource Tertiary}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- User/Student -->
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light={StaticResource SuccessBorderLight}, Dark={StaticResource SuccessBorderDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SuccessBgLight}, Dark={StaticResource SuccessBgDark}}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="SINH VIÊN" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource SuccessDark}" />
                            <Label Text="{Binding UserCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource SuccessDark}" />
                            <Label Text="Thành viên" FontSize="11" TextColor="{StaticResource SuccessColor}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Tìm kiếm & Thêm mới -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                            Padding="4,0">
                        <SearchBar Text="{Binding SearchText}"
                                   Placeholder="Tìm họ tên, username, email..."
                                   HeightRequest="42" />
                    </Border>

                    <!-- Add Account Button -->
                    <Button Grid.Column="1"
                            Text="+ Thêm tài khoản"
                            Command="{Binding NavigateToCreateUserPageCommand}"
                            Background="{StaticResource EmeraldGradientBrush}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            Padding="14,0"
                            FontSize="12"
                            HeightRequest="42"
                            CornerRadius="10"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Bộ lọc Vai trò (Horizontal Scroll) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,2,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Tất cả"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="All"
                                HeightRequest="36" Padding="14,0" FontSize="12" CornerRadius="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource BorderDividerDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Button Text="Admin"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="Admin"
                                HeightRequest="36" Padding="14,0" FontSize="12" CornerRadius="10"
                                BackgroundColor="{StaticResource ErrorDark}" TextColor="{StaticResource White}" />
                        <Button Text="Manager"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="Manager"
                                HeightRequest="36" Padding="14,0" FontSize="12" CornerRadius="10"
                                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" />
                        <Button Text="User"
                                Command="{Binding SetFilterRoleCommand}" CommandParameter="User"
                                HeightRequest="36" Padding="14,0" FontSize="12" CornerRadius="10"
                                BackgroundColor="{StaticResource SuccessDark}" TextColor="{StaticResource White}" />
                    </HorizontalStackLayout>
                </ScrollView>

                    <!-- Danh sách Người dùng (CollectionView Header Title) -->
                    <Label Text="Danh sách Tài khoản &amp; Vai trò" Style="{StaticResource Title3}" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" Padding="30" HorizontalOptions="Center">
                            <Label Text="🔍" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="Không tìm thấy người dùng nào phù hợp" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="14"
                                    Margin="16,0,16,10">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                    <!-- Thông tin Người dùng & Role Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Avatar Circle -->
                                        <Border Grid.Column="0"
                                                HeightRequest="48"
                                                WidthRequest="48"
                                                StrokeShape="RoundRectangle 24"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding RoleBadgeColor}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding AvatarInitials}"
                                                   TextColor="{StaticResource White}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- User Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Label Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       TextColor="{Binding StatusColorHex}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Username, StringFormat='@{0}'}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                            <Label Text="{Binding Email}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                            <Label Text="{Binding Department}"
                                                   FontSize="12"
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                        </VerticalStackLayout>

                                        <!-- Role Badge Pill -->
                                        <Border Grid.Column="2"
                                                StrokeShape="RoundRectangle 16"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding RoleBadgeColor}"
                                                Padding="10,4"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding RoleShortName}"
                                                   TextColor="{StaticResource White}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Nút Thao tác Phân quyền & Quản trị (2 Tầng Responsive) -->
                                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                                        <!-- Hàng 1: Thao tác quyền chính -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <!-- Nút Phân quyền chính (AC 05.3.1) -->
                                            <Button Grid.Column="0"
                                                    Text="⚡ Phân quyền"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="36"
                                                    CornerRadius="8"
                                                    Padding="6,0"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="{StaticResource White}"
                                                    Command="{Binding SelectUserForRoleAssignmentCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                    CommandParameter="{Binding .}" />

                                            <!-- Nút Đổi nhanh ActionSheet -->
                                            <Button Grid.Column="1"
                                                    Text="Đổi nhanh"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="36"
                                                    CornerRadius="8"
                                                    Padding="6,0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource InfoBgLight}, Dark={StaticResource InfoBgDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource InfoTextLight}, Dark={StaticResource InfoTextDark}}"
                                                    Command="{Binding QuickChangeRoleActionSheetCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- Hàng 2: Chi tiết, Khóa, Xóa -->
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <!-- Nút Trang Edit chi tiết (QueryProperty) -->
                                            <Button Grid.Column="0"
                                                    Text="Chi tiết"
                                                    FontSize="12"
                                                    HeightRequest="34"
                                                    CornerRadius="8"
                                                    Padding="4,0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderDividerDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource LightOnDarkBackground}}"
                                                    Command="{Binding NavigateToEditRolePageCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                    CommandParameter="{Binding .}" />

                                            <!-- Nút Khóa / Mở tài khoản -->
                                            <Button Grid.Column="1"
                                                    Text="{Binding IsActive, Converter={toolkit:BoolToObjectConverter TrueObject='Khóa', FalseObject='Mở'}}"
                                                    FontSize="12"
                                                    HeightRequest="34"
                                                    CornerRadius="8"
                                                    Padding="4,0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningBgLight}, Dark={StaticResource WarningBgDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}"
                                                    Command="{Binding ToggleUserStatusCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                    CommandParameter="{Binding .}" />

                                            <!-- Nút Xóa tài khoản -->
                                            <Button Grid.Column="2"
                                                    Text="Xóa"
                                                    FontSize="12"
                                                    HeightRequest="34"
                                                    CornerRadius="8"
                                                    Padding="4,0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBgLight}, Dark={StaticResource ErrorBorderDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight}, Dark={StaticResource ErrorTextDark}}"
                                                    Command="{Binding DeleteUserCommand, Source={RelativeSource AncestorType={x:Type pageModels:UserManagementPageModel}}, x:DataType=pageModels:UserManagementPageModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Modal Dialog Phân quyền (AC 05.3.1) -->
        <Grid BackgroundColor="{StaticResource OverlayBackdrop}"
              IsVisible="{Binding IsRoleModalVisible}"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="20"
                    MaximumWidthRequest="480"
                    Margin="16"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="⚡ Phân quyền Người dùng" Style="{StaticResource Title3}" />
                            <Label Text="{Binding SelectedUser.FullName, StringFormat='Tài khoản: {0}'}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource InfoTextDark}}" />
                            <Label Text="{Binding SelectedUser.Username, StringFormat='Tên đăng nhập: @{0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                FontSize="14"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                Command="{Binding CloseRoleModalCommand}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}" />

                    <!-- Role Selection Options -->
                    <Label Text="Chọn vai trò mới cho tài khoản:" FontAttributes="Bold" FontSize="13" />

                    <!-- Option 1: Admin -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource ErrorBorderLight}, Dark={StaticResource ErrorBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBgLight}, Dark={StaticResource ErrorBgDark}}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Admin}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Admin" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Admin (Quản trị viên)" FontAttributes="Bold" TextColor="{StaticResource ErrorDark}" FontSize="14" />
                                <Label Text="Toàn quyền trên hệ thống, phân quyền và quản lý tài khoản người dùng." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight}, Dark={StaticResource ErrorTextDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 2: Manager -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource InfoBorderLight}, Dark={StaticResource InfoBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InfoBgLight}, Dark={StaticResource InfoBgDark}}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Manager}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Manager" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Manager (Quản lý sự kiện)" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="14" />
                                <Label Text="Tạo sự kiện, phê duyệt sinh viên tham gia, duyệt minh chứng điểm danh (+/- ĐRL)." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource InfoTextLight}, Dark={StaticResource InfoTextDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 2.1: Lecturer -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource InfoBorderLight}, Dark={StaticResource InfoBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InfoBgLight}, Dark={StaticResource InfoBgDark}}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Lecturer}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Lecturer" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Lecturer (Giảng viên / Cố vấn học tập)" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" FontSize="14" />
                                <Label Text="Quản lý sinh viên lớp chủ nhiệm, tạo hoạt động cho lớp, theo dõi điểm rèn luyện của lớp." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource InfoTextLight}, Dark={StaticResource InfoTextDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 2.2: Secretary -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#DDD6FE"
                            BackgroundColor="#F5F3FF"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Secretary}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Secretary" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Secretary (Bí thư chi đoàn lớp)" FontAttributes="Bold" TextColor="#7C3AED" FontSize="14" />
                                <Label Text="Kiểm soát học sinh trong lớp, tạo hoạt động riêng cho lớp, theo dõi điểm rèn luyện các bạn." FontSize="11" TextColor="#6D28D9" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 3: User / Student -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource SuccessBorderLight}, Dark={StaticResource SuccessBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SuccessBgLight}, Dark={StaticResource SuccessBgDark}}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.User}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="User" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="User (Sinh viên / Thành viên)" FontAttributes="Bold" TextColor="{StaticResource SuccessDark}" FontSize="14" />
                                <Label Text="Xem danh sách hoạt động, nhận nhiệm vụ và cập nhật tiến độ cá nhân." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SuccessDark}, Dark={StaticResource SuccessBorderLight}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Option 4: Guest -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource BorderDivider}, Dark={StaticResource BorderDividerDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding SelectedNewRole, Mode=OneWay, Converter={toolkit:EnumToBoolConverter}, ConverterParameter={x:Static models:Role.Guest}}"
                                         CheckedChanged="OnRoleRadioChanged"
                                         Value="Guest" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Guest (Khách vãng lai)" FontAttributes="Bold" TextColor="{StaticResource Gray500}" FontSize="14" />
                                <Label Text="Chỉ xem nội dung công khai, không thể thực hiện chỉnh sửa." FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Modal Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Hủy bỏ"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderDividerDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource LightOnDarkBackground}}"
                                Command="{Binding CloseRoleModalCommand}"
                                HeightRequest="44" />

                        <Button Grid.Column="1"
                                Text="Lưu phân quyền"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                FontAttributes="Bold"
                                Command="{Binding SaveRoleAssignmentCommand}"
                                HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
