<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:CampusActivitiesManager.PageModels"
             x:Class="CampusActivitiesManager.Pages.EventDetailPage"
             x:DataType="pageModels:EventDetailPageModel"
             Title="Chi tiết sự kiện">

    <ScrollView Margin="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="{Binding EventDto.Icon}" FontSize="64" HorizontalOptions="Center" />
            <Label Text="{Binding EventDto.Name}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Phân loại: " FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding EventDto.Category.Title}" FontSize="16" TextColor="{Binding EventDto.Category.Color}" />
            </HorizontalStackLayout>
            
            <Label Text="Mô tả:" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0"/>
            <Label Text="{Binding EventDto.Description}" FontSize="16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
